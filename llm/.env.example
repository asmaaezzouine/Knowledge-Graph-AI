# API keys
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# LLM configuration
GROQ_MODELS=
CHUNK_SIZE=
CHUNK_OVERLAP=
MAX_OUTPUT_TOKENS=
REASONING_EXTRA_TOKENS=
TPM_LIMIT=
CHUNK_PAUSE=

# Graph configuration
GRAPH_LABEL=
RELATION_SOURCE=

# Authentication
AUTH_REQUIRED=
AUTH_USERS=
JWT_SECRET=replace_with_a_secure_secret

# API security
CORS_ORIGINS=

# Audit
AUDIT_RETENTION_JOURS=
